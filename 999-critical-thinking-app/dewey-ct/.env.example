# Ollama configuration (local LLM backend)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional — override if deploying backend separately
BACKEND_URL=http://localhost:8000

# CORS — comma-separated list of allowed frontend origins
# Development default: http://localhost:3001
# Production example: ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=http://localhost:3001

# Rate limiting — requests per minute per IP for /api/qa
QA_RATE_LIMIT=10/minute
