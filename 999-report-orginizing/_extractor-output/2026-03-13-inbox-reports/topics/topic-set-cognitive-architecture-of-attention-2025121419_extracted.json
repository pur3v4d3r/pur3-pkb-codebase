    "callouts": [
      {
        "type": "the-purpose",
        "title": "Untitled",
        "body": "This topic set provides a rigorous, foundational framework for understanding \"Attention\" not merely as a state of focus, but as a complex biological and computational selection mechanism. These topics explore the historical evolution of attentional theories, the debate between structural bottlenecks and resource allocation, the neural networks governing control, and the critical distinction between voluntary and reflexive processing. It is designed to guide a deep dive into how the brain filters the infinite sensory world into finite conscious experience, moving from abstract psychological models to concrete neurobiological evidence.",
        "line_number": 26,
        "source": "topic-set-cognitive-architecture-of-attention-2025121419.md",
        "char_start": 652,
