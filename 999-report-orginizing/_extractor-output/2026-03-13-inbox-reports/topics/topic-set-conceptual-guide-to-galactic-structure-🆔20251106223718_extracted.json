    "code_blocks": [
      {
        "language": "plaintext",
        "code": "A conceptual exploration of galactic morphology, analyzing how the classification of spiral, elliptical, and irregular galaxies reveals their underlying evolutionary history, star formation activity, and past record of tidal interactions and mergers.",
        "line_start": 40,
        "line_end": 42,
        "char_count": 250,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      },
      {
        "language": "plaintext",
        "code": "A qualitative analysis of the processes and consequences of galactic mergers, examining how gravitational interactions drive tidal stripping, trigger starburst events, and contribute to the hierarchical evolution of galaxy mass and morphology, all explained through conceptual models rather than mathematical physics.",
        "line_start": 54,
        "line_end": 56,
        "char_count": 317,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      },
      {
        "language": "plaintext",
        "code": "An investigation into the co-evolutionary relationship between supermassive black holes and their host galaxies, focusing on the conceptual mechanisms of mass accretion and energetic \"feedback\" and their qualitative role in regulating galactic growth and star formation.",
        "line_start": 68,
        "line_end": 70,
        "char_count": 270,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      },
      {
        "language": "plaintext",
        "code": "A descriptive analysis of the galactic baryon cycle, examining the inflow of primordial gas from the intergalactic medium, its condensation into molecular clouds, the qualitative processes of star formation, and the subsequent expulsion and recycling of enriched material through stellar feedback mechanisms.",
        "line_start": 82,
        "line_end": 84,
        "char_count": 308,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      },
      {
        "language": "plaintext",
        "code": "A conceptual examination of the role of dark matter halos as the gravitational architects of galaxy formation, analyzing the qualitative observational evidence for their existence and their foundational function in orchestrating the assembly, structure, and rotational dynamics of visible galaxies.",
        "line_start": 96,
        "line_end": 98,
        "char_count": 298,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      },
      {
        "language": "plaintext",
        "code": "An analysis of the principles and key findings of \"Galactic Archaeology,\" investigating how the chemo-dynamical properties of stellar populations are used as \"fossils\" to reconstruct the assembly history, merger events, and evolutionary past of the Milky Way galaxy.",
        "line_start": 110,
        "line_end": 112,
        "char_count": 266,
        "line_count": 1,
        "source": "topic-set-conceptual-guide-to-galactic-structure-🆔20251106223718.md"
      }
    ],
