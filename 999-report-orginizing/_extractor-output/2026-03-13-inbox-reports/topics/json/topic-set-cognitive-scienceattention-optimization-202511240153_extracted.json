    "code_blocks": [
      {
        "language": "plaintext",
        "code": "A comprehensive analysis of the neural mechanisms of Selective Attention, focusing on the evolution of 'bottleneck' models from Broadbent’s Filter Theory to Lavie’s Perceptual Load Theory, and the neurophysiological processes of sensory gating in the thalamus and cortex.",
        "line_start": 44,
        "line_end": 46,
        "char_count": 271,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      },
      {
        "language": "plaintext",
        "code": "An in-depth examination of the dynamic interplay and competition between the Dorsal Attention Network (endogenous control) and the Ventral Attention Network (exogenous reorientation), analyzing how neural circuit-breaking mechanisms function during task switching and distraction.",
        "line_start": 59,
        "line_end": 61,
        "char_count": 280,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      },
      {
        "language": "plaintext",
        "code": "A critical investigation into the exploitation of the 'Orienting Reflex' and dopamine-driven reward loops by digital interface design, analyzing the specific neurobiological consequences of hyper-stimulation and rapid task-switching on the prefrontal cortex's executive control capabilities.",
        "line_start": 74,
        "line_end": 76,
        "char_count": 291,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      },
      {
        "language": "plaintext",
        "code": "A systematic review of neuroplasticity-based attentional enhancement, evaluating the structural and functional brain changes induced by mindfulness meditation and cognitive training regimens, with a specific focus on the strengthening of the Anterior Cingulate Cortex.",
        "line_start": 89,
        "line_end": 91,
        "char_count": 268,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      },
      {
        "language": "plaintext",
        "code": "A neurocognitive evaluation of the Flow State, detailing the 'Transient Hypofrontality Hypothesis' and the specific neurochemical cascade that facilitates the suspension of self-referential processing in favor of hyper-focused task execution.",
        "line_start": 104,
        "line_end": 106,
        "char_count": 242,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      },
      {
        "language": "plaintext",
        "code": "An analysis of the antagonistic relationship between the Default Mode Network (DMN) and the Task-Positive Network (TPN), exploring the cognitive mechanics of internal distraction, maladaptive mind-wandering, and the metabolic costs of network switching.",
        "line_start": 119,
        "line_end": 121,
        "char_count": 253,
        "line_count": 1,
        "source": "topic-set-cognitive-scienceattention-optimization-202511240153.md"
      }
    ],
