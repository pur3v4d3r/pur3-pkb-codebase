# ============================================================================
# Environment Variables Template
# Master Exemplar Project 2026 - Claude Reasoning Documentation Series
# ============================================================================
#
# IMPORTANT: This is a template file. Copy to .env and fill in actual values.
#
# Setup Instructions:
#   1. Copy this file: cp .env.template .env
#   2. Fill in your actual API keys and configuration
#   3. NEVER commit .env to version control
#   4. Add .env to your .gitignore file
#
# ============================================================================

# ============================================================================
# LLM API Keys (REQUIRED for API-based examples)
# ============================================================================

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (optional alternative)
# Get your key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Model Configuration
# ============================================================================

# Default model to use for examples
DEFAULT_MODEL=claude-sonnet-4

# Alternative model options:
# - claude-opus-4-6 (most capable, higher cost)
# - claude-sonnet-4 (balanced)
# - gpt-4 (OpenAI alternative)
# - gpt-3.5-turbo (faster, lower cost)

# Maximum tokens for generation
MAX_TOKENS=4096

# Temperature for sampling (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=1.0

# ============================================================================
# Extended Thinking Configuration
# ============================================================================

# Enable extended thinking mode
EXTENDED_THINKING_ENABLED=true

# Thinking budget (tokens allocated for reasoning)
THINKING_BUDGET=2000

# Thinking mode: "enabled", "disabled", "auto"
THINKING_MODE=enabled

# ============================================================================
# System Configuration
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable request/response logging
LOG_API_CALLS=false

# Cache directory for response caching
CACHE_DIR=.cache

# Enable response caching
CACHE_ENABLED=true

# Cache TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# ============================================================================
# Testing Configuration
# ============================================================================

# Enable mock mode for tests (uses mock LLM instead of real API)
MOCK_LLM_ENABLED=true

# Test timeout in seconds
TEST_TIMEOUT=30

# ============================================================================
# Performance & Rate Limiting
# ============================================================================

# Max concurrent API requests
MAX_CONCURRENT_REQUESTS=5

# Rate limit: requests per minute
RATE_LIMIT_RPM=50

# Retry configuration
MAX_RETRIES=3
RETRY_INITIAL_DELAY=1.0

# ============================================================================
# Optional: Local Model Configuration
# ============================================================================
# Uncomment if using local models instead of APIs

# Local model path or HuggingFace model ID
# LOCAL_MODEL_PATH=meta-llama/Llama-2-70b-chat-hf

# Device for local inference: cpu, cuda, mps
# DEVICE=cuda

# Batch size for local inference
# BATCH_SIZE=1

# ============================================================================
# Optional: Advanced Features
# ============================================================================

# Enable prompt caching (Anthropic feature)
# PROMPT_CACHING_ENABLED=true

# Enable streaming responses
# STREAMING_ENABLED=false

# Custom API endpoint (for proxies or custom deployments)
# API_BASE_URL=https://api.anthropic.com

# Request timeout in seconds
# API_TIMEOUT=60

# ============================================================================
# Security Notes
# ============================================================================
#
# - NEVER commit .env files with real API keys
# - Use environment-specific .env files (.env.dev, .env.prod)
# - Consider using secret management tools for production
# - Rotate API keys regularly
# - Use read-only API keys when possible
#
# ============================================================================

# ============================================================================
# Example Usage in Python
# ============================================================================
#
# Load environment variables:
#
#   from dotenv import load_dotenv
#   import os
#
#   load_dotenv()  # Load .env file
#
#   api_key = os.getenv("ANTHROPIC_API_KEY")
#   model = os.getenv("DEFAULT_MODEL", "claude-sonnet-4")
#
# ============================================================================
