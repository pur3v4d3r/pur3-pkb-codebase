   /* ═══════════════════════════════════════════════════════════════════════════
      PART 17: INLINE CODE
      ══════════════════════════════════════════════════════════════════════════ */
   
   code {
     background-color: var(--v4d3r-grey-dark) !important;
     color: var(--v4d3r-red-bright) !important;
     padding: 2px 6px !important;
     border-radius: var(--v4d3r-radius-sm) !important;
     font-family: var(--font-monospace) !important;
     font-size: 0.9em !important;
     border: 1px solid var(--v4d3r-grey-medium-dark) !important;
   }
   
   .cm-inline-code {
     background-color: var(--v4d3r-grey-dark) !important;
     color: var(--v4d3r-red-bright) !important;
     padding: 2px 4px !important;
     border-radius: var(--v4d3r-radius-sm) !important;
   }
   





/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 3: TABLE STYLING
═══════════════════════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T1: BASE TABLE STYLING
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view table,
.markdown-rendered table {
  width: 100%;
  border-collapse: collapse;
  margin: 1em 0;
  background: var(--v4d3r-black-charcoal);
  border: 1px solid var(--v4d3r-grey-dark);
  border-radius: 8px;
  overflow: hidden;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T2: TABLE HEADER STYLING
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view th,
.markdown-rendered th {
  background: linear-gradient(135deg, var(--v4d3r-purple-dark), var(--v4d3r-purple-darker));
  color: var(--v4d3r-grey-snow);
  font-weight: 600;
  padding: 12px 16px;
  text-align: left;
  border-bottom: 2px solid var(--v4d3r-purple-primary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 0.875em;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T3: TABLE CELL STYLING
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view td,
.markdown-rendered td {
  padding: 10px 16px;
  border-bottom: 1px solid var(--v4d3r-grey-darkest);
  color: var(--v4d3r-grey-pale);
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T4: ZEBRA STRIPING
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view tr:nth-child(even),
.markdown-rendered tr:nth-child(even) {
  background: var(--v4d3r-black-soft);
}

.markdown-preview-view tr:nth-child(odd),
.markdown-rendered tr:nth-child(odd) {
  background: var(--v4d3r-black-rich);
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T5: ROW HOVER EFFECT
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view tbody tr:hover,
.markdown-rendered tbody tr:hover {
  background: rgba(105, 100, 97, 0.15) !important;
  transition: background 0.2s ease;
}

.markdown-preview-view tbody tr:hover td,
.markdown-rendered tbody tr:hover td {
  color: var(--v4d3r-grey-snow);
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T6: FIRST COLUMN EMPHASIS
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view td:first-child,
.markdown-rendered td:first-child {
  font-weight: 500;
  color: var(--v4d3r-purple-pale);
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T7: STICKY TABLE HEADERS
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view thead,
.markdown-rendered thead {
  position: sticky;
  top: 0;
  z-index: 10;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T8: COMPACT TABLE VARIANT (use cssclass: table-compact)
───────────────────────────────────────────────────────────────────────── */
/*
.table-compact table th,
.table-compact table td {
  padding: 6px 10px;
  font-size: 0.85em;
}
*/

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T9: WIDE TABLE VARIANT (use cssclass: table-wide)
───────────────────────────────────────────────────────────────────────── */
.table-wide table {
  max-width: none;
}

.table-wide table th,
.table-wide table td {
  padding: 16px 24px!important;
  font-size: 1em!important;
}


/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T10: BORDERLESS TABLE VARIANT (use cssclass: table-borderless)
───────────────────────────────────────────────────────────────────────── */
/*
.table-borderless table {
  border: none;
}

.table-borderless table th,
.table-borderless table td {
  border: none;
}
*/

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T11: MINIMAL TABLE VARIANT (use cssclass: table-minimal)
───────────────────────────────────────────────────────────────────────── */
/*
.table-minimal table {
  border: none;
  border-radius: 0;
}
.table-minimal table th {
  background: var(--v4d3r-grey-dark)!important;
  border-bottom: 1px solid var(--v4d3r-grey-medium)!important;
  color: var(--v4d3r-grey-snow)!important;
}
.table-minimal table td {
  background: transparent!important;
  border: none;
  text-align: left;
}
*/

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T12: LATEX-STYLE TABLE (use cssclass: table-latex)
───────────────────────────────────────────────────────────────────────── */
.table-latex table {
  border: none;
  border-top: 2px solid var(--v4d3r-grey-pale)!important;
  border-bottom: 2px solid var(--v4d3r-grey-pale)!important;
  border-radius: 0;
}

.table-latex table th {
  background: transparent!important;
  border-bottom: 1px solid var(--v4d3r-grey-medium)!important;
  color: var(--v4d3r-grey-snow)!important;
  font-variant: small-caps;
}

.table-latex table td {
  background: transparent!important;
  border: none;
  text-align: center;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T13: TABLE WITH SHADOWS (use cssclass: table-shadow)
───────────────────────────────────────────────────────────────────────── */
.table-shadow table {
  box-shadow: 0 4px 6px 1px rgba(103, 98, 95, 0.4)!important;
  border: none;
  border-radius: 8px;
}
.table-shadow thead {
  box-shadow: 0 2px 4px 1px rgba(103, 98, 95, 0.3)!important;
}
.table-shadow tbody tr {
  box-shadow: 0 2px 4px 1px rgba(103, 98, 95, 0.3)!important;
  transition: box-shadow 0.2s ease;
  
}

.table-shadow tbody tr:hover {
  box-shadow: inset 0 0 0 2px var(--v4d3r-purple-primary)!important;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T14: RESPONSIVE TABLE (horizontal scroll on small screens)
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view .table-wrapper,
.markdown-rendered .table-wrapper {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch!important;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T15: COLUMN ALIGNMENT UTILITIES
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view th.align-left,
.markdown-rendered th.align-left,
.markdown-preview-view td.align-left,
.markdown-rendered td.align-left {
  text-align: left!important;
}
.markdown-preview-view th.align-center,
.markdown-rendered th.align-center,
.markdown-preview-view td.align-center,
.markdown-rendered td.align-center {
  text-align: center!important;
}
.markdown-preview-view th.align-right,
.markdown-rendered th.align-right,
.markdown-preview-view td.align-right,
.markdown-rendered td.align-right {
  text-align: right!important;
}



/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T16: HIGHLIGHTED ROW (use inline style or class)
───────────────────────────────────────────────────────────────────────── */
.markdown-preview-view tr.highlight,
.markdown-rendered tr.highlight {
  background: rgba(105, 100, 97, 0.25) !important;
  border-left: 3px solid var(--v4d3r-purple-primary)!important;
}

/* ─────────────────────────────────────────────────────────────────────────
   [TOGGLE] T17: MONOSPACE DATA CELLS (use cssclass: table-mono)
───────────────────────────────────────────────────────────────────────── */
.table-mono table td {
  font-family: 'JetBrains Mono', 'Fira Code', monospace!important;
  font-size: 0.9em!important;
}

/* ═══════════════════════════════════════════════════════════════════════════
   END OF PART 2 - TABLE STYLING
   Continue to Part 3 for PLUGIN styling
═══════════════════════════════════════════════════════════════════════════ */

   /* ═══════════════════════════════════════════════════════════════════════════
      PART 21: TABLES
      ══════════════════════════════════════════════════════════════════════════ */
   
   table {
     border-collapse: collapse !important;
     width: 100% !important;
     margin: var(--v4d3r-space-md) 0 !important;
     background-color: var(--v4d3r-grey-darker) !important;
     border: 1px solid var(--v4d3r-grey-dark) !important;
     border-radius: var(--v4d3r-radius-md) !important;
     overflow: hidden !important;
   }
   
   thead {
     background-color: var(--v4d3r-grey-dark) !important;
   }
   
   th {
     color: var(--v4d3r-red-bright) !important;
     font-weight: var(--font-weight-bold) !important;
     text-align: left !important;
     padding: var(--v4d3r-space-sm) var(--v4d3r-space-md) !important;
     border-bottom: 2px solid var(--v4d3r-red-dark) !important;
   }
   
   td {
     color: var(--v4d3r-grey-light) !important;
     padding: var(--v4d3r-space-sm) var(--v4d3r-space-md) !important;
     border-bottom: 1px solid var(--v4d3r-grey-dark) !important;
   }
   
   tr:hover {
     background-color: var(--v4d3r-red-alpha-10) !important;
   }
   
   tr:last-child td {
     border-bottom: none !important;
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 22: HORIZONTAL RULES
      ══════════════════════════════════════════════════════════════════════════ */
   
   hr {
     border: none !important;
     height: 2px !important;
     background: linear-gradient(90deg, transparent, var(--v4d3r-red-dark), transparent) !important;
     margin: var(--v4d3r-space-xl) 0 !important;
   }
   


   

   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 26: GRAPH VIEW
      ══════════════════════════════════════════════════════════════════════════ */
   
   .graph-view {
     background-color: var(--v4d3r-grey-darkest) !important;
   }
   
   .graph-view.color-fill {
     color: var(--v4d3r-red-primary) !important;
   }
   
   .graph-view.color-fill-highlight {
     color: var(--v4d3r-red-bright) !important;
   }
   
   .graph-view.color-line {
     color: var(--v4d3r-grey-medium-dark) !important;
   }
   
   .graph-view.color-text {
     color: var(--v4d3r-grey-light) !important;
   }
   
   .graph-view.color-fill-unresolved {
     color: var(--v4d3r-grey) !important;
     opacity: 0.5 !important;
   }

   /*

/* ═══════════════════════════════════════════════════════════
   CARD MODE FOR WORKSPACE LEAVES
   ══════════════════════════════════════════════════════════ */

.workspace-leaf {
  margin: 8px !important;
  border-radius: 12px !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  border: 1px solid rgba(58, 58, 58, 0.5) !important;
}



/*
═══════════════════════════════════════════════════════════════════════════════
 SNIPPET: Glowing Headers System
 Category: Typography
 Purpose: Neon glow heading hierarchy with RED/BLACK/GREY palette
 Author: Pur3v4d3r
 Created: 2025-12-29
 Version: 1.0.0

 Description:
 Complete heading hierarchy (H1-H6) featuring dark text with glowing
 purple neon text-shadow effects. Uses JetBrains Mono with all-small-caps
 for a professional cyberpunk aesthetic.

 Color Palette:
 - Primary Glow: #67625F (Vivid Purple)
 - Secondary Glow: #5D5856 (Deep Purple)
 - Tertiary Glow: #494543 (Dark Purple)
 - Text Base: #040404 (Near Black)
 - Accent Grey: #858585 (Medium Grey)

 Font Requirements:
 - JetBrains Mono (recommended)
 - Download: https://www.jetbrains.com/lp/mono/

 Compatibility: Obsidian 1.5+
═══════════════════════════════════════════════════════════════════════════════
*/

/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 1 - Intense Red Glow
   Primary headings with maximum glow intensity
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h1,
.theme-dark .markdown-reading-view h1,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-1,
.theme-dark .cm-header-1,
.markdown-reading-view h1,
.markdown-preview-view h1,
.cm-header-1,
h1 {
    font-family: "Jetbrains Mono", var(--font-monospace) !important;
    font-size: 1.8em !important;
    font-weight: 600 !important;
    font-variant: all-small-caps !important;
    color: #000000 !important;                  /* Pure Black */
    text-decoration: underline !important;
    text-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px #ff0000ee, 0 0 10px #ff00004a,
                 0 0 14px #ff00004a, 0 0 18px #ff000037;
                 /* Strong purple neon glow */
  }
  
/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 2 - Strong Red Glow
   Section headings with bold presence
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h2,
.theme-dark .markdown-reading-view h2,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-2,
.theme-dark .cm-header-2,
.markdown-reading-view h2,
.markdown-preview-view h2,
.cm-header-2,
h2 {
  font-family: "Jetbrains Mono", var(--font-monospace) !important;
  font-size: 1.8em !important;
  font-weight: 600 !important;
  font-variant: all-small-caps !important;
  color: #000000 !important;                  /* Pure Black */
  text-decoration: underline !important;
  text-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px #ff0000ee, 0 0 10px #ff00004a,
  0 0 14px #ff00004a, 0 0 18px #ff000037;
  /* Strong purple neon glow */
}

/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 3 - Medium Red Glow
   Subsection headings with reduced intensity
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h3,
.theme-dark .markdown-reading-view h3,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-3,
.theme-dark .cm-header-3,
.markdown-reading-view h3,
.markdown-preview-view h3,
.cm-header-3,
h3 {
    font-family: "Jetbrains Mono", var(--font-monospace) !important;
    font-size: 1.8em !important;
    font-weight: 100 !important;
    font-variant: all-small-caps !important;
    color: rgb(255, 255, 255) !important;                  /* Pure Black */
    text-decoration: underline !important;
    text-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px #ff0000ee, 0 0 10px #ff00004a,
                 0 0 14px #ff00004a, 0 0 18px #ff000037;
                 /* Strong purple neon glow */
  }

/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 4 - Subtle Red Glow
   Minor section headings with softer effect
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h4,
.theme-dark .markdown-reading-view h4,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-4,
.theme-dark .cm-header-4,
.markdown-reading-view h4,
.markdown-preview-view h4,
.cm-header-4,
h4 {
  font-family: "Jetbrains Mono", var(--font-monospace) !important;
  font-size: 1.55em !important;
  font-weight: 500 !important;
  font-variant: all-small-caps !important;
  color: #000000 !important;                  /* Pure Black */
  text-decoration: underline !important;
  text-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px #ff0000ee, 0 0 10px #ff00004a,
  0 0 14px #ff00004a, 0 0 18px #ff000037;
  /* Strong purple neon glow */
}

/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 5 - Grey-Red Hybrid Glow
   Detail headings with grey undertones
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h5,
.theme-dark .markdown-reading-view h5,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-5,
.theme-dark .cm-header-5,
.markdown-reading-view h5,
.markdown-preview-view h5,
.cm-header-5,
h5 {
  font-family: "Jetbrains Mono", var(--font-monospace) !important;
  font-size: 1.45em !important;
  font-weight: 400 !important;
  font-variant: all-small-caps !important;
  color: #ffffff !important;                  /* Pure Black */
  text-decoration: underline !important;
  text-shadow: 0 0 2px rgb(255, 0, 0), 0 0 4px #ff0000aa, 0 0 7px #ff000077,
               0 0 10px #ff000055;
               /* Soft purple neon glow */
}

/* ══════════════════════════════════════════════════════════
   HEADING LEVEL 6 - Minimal Red Glow
   Smallest headings with faint purple effect
   ══════════════════════════════════════════════════════════ */
.theme-dark .markdown-preview-view h6,
.theme-dark .markdown-reading-view h6,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-6,
.theme-dark .cm-header-6,
.markdown-reading-view h6,
.markdown-preview-view h6,
.cm-header-6,
h6 {
  font-family: "Jetbrains Mono", var(--font-monospace) !important;
  font-size: 1.35em !important;
  font-weight: 400 !important;
  font-variant: all-small-caps !important;
  color: #000000 !important;                  /* Pure Black */
  text-decoration: underline !important;
  text-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px #ff0000ee, 0 0 10px #ff00004a,
  0 0 14px #ff00004a, 0 0 18px #ff000037;
  /* Strong purple neon glow */
}

/* ══════════════════════════════════════════════════════════
   END OF GLOWING HEADERS SYSTEM
   ══════════════════════════════════════════════════════════ */



/*
╔══════════════════════════════════════════════════════════════════════════════╗
║                                                                              ║
║  CALLOUT MOD: Neon Red Shadow                                                ║
║  Black/transparent background, neon-red glowing borders, white body text,    ║
║  red-glow bold/italic, dotted-underline dark-red links, deep shadow.         ║
║                                                                              ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  Author:    Pur3v4d3r                                                        ║
║  Created:   2026-04-06                                                       ║
║  Obsidian:  v1.5.0+                                                          ║
║  REQUIRES:  callout-base.css enabled                                         ║
║  CONFLICTS: Other layout/effect mods (enable only ONE mod at a time)         ║
╠══════════════════════════════════════════════════════════════════════════════╣
║                                                                              ║
║  FEATURES:                                                                   ║
║  • Black/transparent background                                              ║
║  • White body text                                                           ║
║  • Red bold title with glow                                                  ║
║  • Dark red links with dotted underline                                      ║
║  • Red glowing bold & italic text                                            ║
║  • Neon red border with glow effect                                          ║
║  • Deep shadow for 3D depth                                                  ║
║  • Rounded corners with padding                                              ║
║  • Works in Live Preview and Reading Mode                                    ║
║                                                                              ║
╚══════════════════════════════════════════════════════════════════════════════╝
*/


/* ═══════════════════════════════════════════════════════════════════════════
   MOD-LEVEL VARIABLES
   Override these to tweak the neon-red look without touching rules below.
   ═══════════════════════════════════════════════════════════════════════════ */

.theme-dark,
.theme-light {
  /* ── Neon Red Palette ─────────────────────────────────────────────────── */
  --nrs-red:            255, 30, 30;       /* Primary neon red              */
  --nrs-red-dark:       180, 20, 20;       /* Darker red for links          */
  --nrs-red-deep:       140, 10, 10;       /* Even deeper for hover states  */

  /* ── Surface ──────────────────────────────────────────────────────────── */
  --nrs-bg:             0, 0, 0;           /* Pure black background         */
  --nrs-bg-opacity:     0.88;              /* Background transparency       */
  --nrs-title-bg:       0.10;             /* Title bar red tint opacity    */

  /* ── Text ─────────────────────────────────────────────────────────────── */
  --nrs-text:           240, 240, 240;     /* White body text               */
  --nrs-text-dim:       200, 200, 200;     /* Slightly dimmer text          */

  /* ── Glow Intensities ─────────────────────────────────────────────────── */
  --nrs-glow-sm:        0 0 10px;
  --nrs-glow-md:        0 0 22px;
  --nrs-glow-lg:        0 0 44px;
  --nrs-glow-xl:        0 0 70px;

  /* ── Structural ───────────────────────────────────────────────────────── */
  --nrs-radius:         12px;
  --nrs-border-width:   2px;
  --nrs-padding:        16px 18px;
  --nrs-content-pad:    14px 18px;
  --nrs-title-pad:      12px 16px;
  --nrs-shadow-depth:   0 8px 32px rgba(0, 0, 0, 0.7),
                        0 2px 8px rgba(0, 0, 0, 0.5);
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 1: CONTAINER
   Neon red border glow + black background + deep shadow
   ═══════════════════════════════════════════════════════════════════════════ */

/* --- Main Callout Container --- */
.callout {
  background: rgba(var(--nrs-bg), var(--nrs-bg-opacity)) !important;
  border: var(--nrs-border-width) solid rgba(var(--nrs-red), 0.55) !important;
  border-left: 4px solid rgba(var(--nrs-red), 0.85) !important;
  border-radius: var(--nrs-radius) !important;
  padding: 0 !important;
  overflow: hidden !important;
  position: relative !important;
  box-shadow:
    /* Neon glow layers */
    var(--nrs-glow-sm) rgba(var(--nrs-red), 0.30),
    var(--nrs-glow-md) rgba(var(--nrs-red), 0.18),
    var(--nrs-glow-lg) rgba(var(--nrs-red), 0.10),
    /* Depth shadow */
    var(--nrs-shadow-depth) !important;
  transition:
    box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
    border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

/* --- Hover: intensify glow --- */
.callout:hover {
  border-color: rgba(var(--nrs-red), 0.80) !important;
  border-left-color: rgb(var(--nrs-red)) !important;
  box-shadow:
    var(--nrs-glow-sm) rgba(var(--nrs-red), 0.50),
    var(--nrs-glow-md) rgba(var(--nrs-red), 0.30),
    var(--nrs-glow-lg) rgba(var(--nrs-red), 0.18),
    var(--nrs-glow-xl) rgba(var(--nrs-red), 0.08),
    0 10px 40px rgba(0, 0, 0, 0.75),
    0 4px 12px rgba(0, 0, 0, 0.55) !important;
  transform: translateY(-1px) !important;
}

/* --- Subtle neon top-line accent --- */
.callout::before {
  content: '' !important;
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  height: 2px !important;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(var(--nrs-red), 0.50) 25%,
    rgba(var(--nrs-red), 0.85) 50%,
    rgba(var(--nrs-red), 0.50) 75%,
    transparent 100%) !important;
  box-shadow: 0 0 8px rgba(var(--nrs-red), 0.40) !important;
  pointer-events: none !important;
  z-index: 1 !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 2: TITLE BAR
   Red bold title with subtle glow
   ═══════════════════════════════════════════════════════════════════════════ */

.callout-title {
  background: rgba(var(--nrs-red), var(--nrs-title-bg)) !important;
  padding: var(--nrs-title-pad) !important;
  border-bottom: 1px solid rgba(var(--nrs-red), 0.20) !important;
  transition: background 0.3s ease !important;
}

.callout:hover .callout-title {
  background: rgba(var(--nrs-red), 0.15) !important;
}

/* --- Title Text: Red + Bold + Glow --- */
.callout-title-inner {
  color: rgb(var(--nrs-red)) !important;
  font-weight: 700 !important;
  letter-spacing: 0.4px !important;
  text-shadow:
    0 0 6px rgba(var(--nrs-red), 0.45),
    0 0 14px rgba(var(--nrs-red), 0.20) !important;
}

/* --- Icon: inherits callout-color so it matches each callout type --- */
.callout-icon {
  color: rgb(var(--callout-color)) !important;
  filter: drop-shadow(0 0 6px rgba(var(--callout-color), 0.45)) !important;
  transition: transform 0.3s ease, filter 0.3s ease !important;
}

.callout:hover .callout-icon {
  transform: scale(1.1) !important;
  filter: drop-shadow(0 0 10px rgba(var(--callout-color), 0.65)) !important;
}

/* --- Fold indicator --- */
.callout-fold {
  color: rgba(var(--nrs-red), 0.65) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 3: CONTENT AREA
   White text, proper padding, scoped internal element styling
   ═══════════════════════════════════════════════════════════════════════════ */

.callout-content {
  padding: var(--nrs-content-pad) !important;
  color: rgb(var(--nrs-text)) !important;
  background: transparent !important;
  font-size: 0.93em !important;
  line-height: 1.70 !important;
}

.callout-content > p:first-child {
  margin-top: 0 !important;
}

.callout-content > p:last-child {
  margin-bottom: 0 !important;
}

/* ── Paragraphs ─────────────────────────────────────────────────────────── */
.callout-content p {
  color: rgb(var(--nrs-text)) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 4: BOLD & ITALIC — Red Glow Effect
   ═══════════════════════════════════════════════════════════════════════════ */

/* --- Bold: Red + Glow --- */
.callout-content strong,
.callout-content b {
  color: rgb(var(--nrs-red)) !important;
  font-weight: 700 !important;
  text-shadow:
    0 0 5px rgba(var(--nrs-red), 0.50),
    0 0 12px rgba(var(--nrs-red), 0.25) !important;
}

/* --- Italic: Red + Glow (softer) --- */
.callout-content em,
.callout-content i {
  color: rgb(var(--nrs-red)) !important;
  font-style: italic !important;
  text-shadow:
    0 0 5px rgba(var(--nrs-red), 0.45),
    0 0 12px rgba(var(--nrs-red), 0.20) !important;
}

/* --- Bold-Italic combo: Full Glow --- */
.callout-content strong em,
.callout-content em strong,
.callout-content b i,
.callout-content i b {
  color: rgb(var(--nrs-red)) !important;
  font-weight: 700 !important;
  font-style: italic !important;
  text-shadow:
    0 0 6px rgba(var(--nrs-red), 0.60),
    0 0 14px rgba(var(--nrs-red), 0.35),
    0 0 24px rgba(var(--nrs-red), 0.15) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 5: LINKS — Dark Red + Dotted Underline
   Covers both wiki-links and external links in both reading & live preview
   ═══════════════════════════════════════════════════════════════════════════ */

/* --- All links inside callout content --- */
.callout-content a,
.callout-content a.internal-link,
.callout-content a.external-link,
.callout-content .internal-link,
.callout-content .cm-hmd-internal-link,
.callout-content .cm-link,
.callout-content .cm-url {
  color: rgb(var(--nrs-red-dark)) !important;
  text-decoration: underline dotted !important;
  text-decoration-color: rgba(var(--nrs-red-dark), 0.55) !important;
  text-underline-offset: 3px !important;
  text-decoration-thickness: 1.5px !important;
  transition: color 0.2s ease, text-decoration-color 0.2s ease !important;
}

/* --- Link hover --- */
.callout-content a:hover,
.callout-content a.internal-link:hover,
.callout-content a.external-link:hover,
.callout-content .internal-link:hover {
  color: rgb(var(--nrs-red)) !important;
  text-decoration: underline dotted !important;
  text-decoration-color: rgba(var(--nrs-red), 0.75) !important;
  text-decoration-thickness: 2px !important;
  text-shadow: 0 0 6px rgba(var(--nrs-red), 0.30) !important;
}

/* --- Unresolved / ghost links --- */
.callout-content a.is-unresolved,
.callout-content .is-unresolved .cm-hmd-internal-link {
  color: rgba(var(--nrs-red-deep), 0.70) !important;
  text-decoration-style: dashed !important;
  opacity: 0.75 !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 6: CODE INLINE & BLOCKS
   ═══════════════════════════════════════════════════════════════════════════ */

.callout-content code {
  background: rgba(var(--nrs-red), 0.08) !important;
  color: rgb(var(--nrs-red)) !important;
  padding: 2px 6px !important;
  border-radius: 4px !important;
  font-size: 0.88em !important;
  border: 1px solid rgba(var(--nrs-red), 0.15) !important;
}

.callout-content pre {
  background: rgba(var(--nrs-bg), 0.95) !important;
  border: 1px solid rgba(var(--nrs-red), 0.20) !important;
  border-radius: 6px !important;
  padding: 10px 14px !important;
}

.callout-content pre code {
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  color: rgb(var(--nrs-text-dim)) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 7: LISTS
   ═══════════════════════════════════════════════════════════════════════════ */

.callout-content ul,
.callout-content ol {
  padding-left: 1.5em !important;
  color: rgb(var(--nrs-text)) !important;
}

.callout-content li {
  color: rgb(var(--nrs-text)) !important;
}

.callout-content li::marker {
  color: rgba(var(--nrs-red), 0.55) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 8: NESTED CALLOUTS
   Reduced intensity for inner callouts to maintain hierarchy
   ═══════════════════════════════════════════════════════════════════════════ */

.callout .callout {
  border-width: 1.5px !important;
  border-left-width: 3px !important;
  border-radius: 8px !important;
  box-shadow:
    0 0 4px rgba(var(--nrs-red), 0.18),
    0 0 10px rgba(var(--nrs-red), 0.08),
    0 4px 16px rgba(0, 0, 0, 0.45) !important;
}

.callout .callout .callout {
  box-shadow:
    0 0 3px rgba(var(--nrs-red), 0.12),
    0 2px 8px rgba(0, 0, 0, 0.35) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 9: BLOCKQUOTES INSIDE CALLOUTS
   ═══════════════════════════════════════════════════════════════════════════ */

.callout-content blockquote {
  border-left: 3px solid rgba(var(--nrs-red), 0.40) !important;
  background: rgba(var(--nrs-red), 0.04) !important;
  padding: 8px 14px !important;
  margin: 0.8em 0 !important;
  border-radius: 0 6px 6px 0 !important;
  color: rgb(var(--nrs-text-dim)) !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 10: LIVE PREVIEW SPECIFICS
   Ensure the styling applies correctly in CM6 live-preview editor mode
   ═══════════════════════════════════════════════════════════════════════════ */

/* Live preview callout wrapper */
.cm-callout .callout {
  background: rgba(var(--nrs-bg), var(--nrs-bg-opacity)) !important;
  border: var(--nrs-border-width) solid rgba(var(--nrs-red), 0.55) !important;
  border-left: 4px solid rgba(var(--nrs-red), 0.85) !important;
  border-radius: var(--nrs-radius) !important;
  box-shadow:
    var(--nrs-glow-sm) rgba(var(--nrs-red), 0.30),
    var(--nrs-glow-md) rgba(var(--nrs-red), 0.18),
    var(--nrs-glow-lg) rgba(var(--nrs-red), 0.10),
    var(--nrs-shadow-depth) !important;
}

/* Live preview title */
.cm-callout .callout-title-inner {
  color: rgb(var(--nrs-red)) !important;
  font-weight: 700 !important;
  text-shadow:
    0 0 6px rgba(var(--nrs-red), 0.45),
    0 0 14px rgba(var(--nrs-red), 0.20) !important;
}

/* Live preview content text */
.cm-callout .callout-content {
  color: rgb(var(--nrs-text)) !important;
}

/* Live preview bold/italic */
.cm-callout .callout-content strong,
.cm-callout .callout-content b {
  color: rgb(var(--nrs-red)) !important;
  text-shadow:
    0 0 5px rgba(var(--nrs-red), 0.50),
    0 0 12px rgba(var(--nrs-red), 0.25) !important;
}

.cm-callout .callout-content em,
.cm-callout .callout-content i {
  color: rgb(var(--nrs-red)) !important;
  text-shadow:
    0 0 5px rgba(var(--nrs-red), 0.45),
    0 0 12px rgba(var(--nrs-red), 0.20) !important;
}

/* Live preview links */
.cm-callout .callout-content a,
.cm-callout .callout-content .internal-link,
.cm-callout .callout-content .cm-hmd-internal-link {
  color: rgb(var(--nrs-red-dark)) !important;
  text-decoration: underline dotted !important;
  text-decoration-color: rgba(var(--nrs-red-dark), 0.55) !important;
  text-underline-offset: 3px !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 4: CALLOUT TYPE COLOR ASSIGNMENTS
   Groups of callout types mapped to accent colors.
   Add/remove types from groups to customize your palette.
   
   FORMAT: .callout[data-callout="type-name"] { --callout-color: var(--co-X); }
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── GROUP 1: Info & Definitions — Electric Purple ─────────────────────── */
.callout[data-callout="info"],
.callout[data-callout="note"],
.callout[data-callout="abstract"],
.callout[data-callout="summary"],
.callout[data-callout="tldr"],
.callout[data-callout="definition"],
.callout[data-callout="concept"],
.callout[data-callout="description"],
.callout[data-callout="overview"],
.callout[data-callout="explanation"],
.callout[data-callout="glossary"],
.callout[data-callout="terminology"],
.callout[data-callout="terms"],
.callout[data-callout="details"],
.callout[data-callout="about-the-author"],
.callout[data-callout="section-summary"],
.callout[data-callout="claude-insight"],
.callout[data-callout="far-transfer"],
.callout[data-callout="debate"],
.callout[data-callout="schema-activation"],
.callout[data-callout="active-reading"],
.callout[data-callout="active-reading-prompt"],
.callout[data-callout="comprehensive-reference"] {
  --callout-color: var(--co-purple);
}

/* ─── GROUP 2: Success & Completion — Neon Green ────────────────────────── */
