}

/* ─── GROUP 11: Ideas & Creativity — Hot Pink ───────────────────────────── */
.callout[data-callout="idea"],
.callout[data-callout="brainstorm"],
.callout[data-callout="insight"],
.callout[data-callout="discovery"],
