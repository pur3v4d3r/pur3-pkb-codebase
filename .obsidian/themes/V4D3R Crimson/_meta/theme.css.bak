/*
═══════════════════════════════════════════════════════════════════════════════
 V4D3R CRIMSON THEME - FOUNDATION VARIABLE SYSTEM
 
 Theme: V4D3R Crimson
 Version: 1.0.0
 Author: Pur3v4d3r
 Description: Production-ready dark theme with Red, Black, and Grey palette
 Obsidian Version: 1.5.0+
 
 PART 1 OF 7: FOUNDATION VARIABLES
 This file establishes the core variable system used throughout the theme.
 All color, typography, spacing, and animation values are defined here.
═══════════════════════════════════════════════════════════════════════════════
*/

/* ═══════════════════════════════════════════════════════════════════════════
   1.1 COLOR PALETTE - RED, BLACK, GREY SYSTEM
   ══════════════════════════════════════════════════════════════════════════ */

.theme-dark,
:root {
  /* ─────────────────────────────────────────────────────────────────────────
     RED SPECTRUM - Primary Theme Accents
     ───────────────────────────────────────────────────────────────────────── */
  
  /* Primary Reds - Main accent colors */
  --v4d3r-red-primary: #DC143C;        /* Crimson Red - Primary accent */
  --v4d3r-red-dark: #8B0000;           /* Dark Red - Borders, subtle accents */
  --v4d3r-red-bright: #FF6B6B;         /* Salmon Red - Highlights, hover states */
  --v4d3r-red-accent: #FF0000;         /* Pure Red - Critical elements, warnings */
  --v4d3r-red-deep: #660000;           /* Deep Red - Shadows, depth */
  
  /* Red Variants - Opacity-based for overlays */
  --v4d3r-red-alpha-10: rgba(220, 20, 60, 0.1);   /* 10% Crimson */
  --v4d3r-red-alpha-15: rgba(220, 20, 60, 0.15);  /* 15% Crimson */
  --v4d3r-red-alpha-20: rgba(220, 20, 60, 0.2);   /* 20% Crimson */
  --v4d3r-red-alpha-30: rgba(220, 20, 60, 0.3);   /* 30% Crimson */
  --v4d3r-red-alpha-50: rgba(220, 20, 60, 0.5);   /* 50% Crimson */
  
  /* ─────────────────────────────────────────────────────────────────────────
     BLACK SPECTRUM - Deep Backgrounds
     ───────────────────────────────────────────────────────────────────────── */
  
  --v4d3r-black: #000000;              /* Pure Black - Deep backgrounds */
  --v4d3r-black-soft: #0A0A0A;         /* Soft Black - Slight depth variation */
  
  /* Black Variants - For depth and layering */
  --v4d3r-black-alpha-50: rgba(0, 0, 0, 0.5);     /* 50% Black */
  --v4d3r-black-alpha-70: rgba(0, 0, 0, 0.7);     /* 70% Black */
  --v4d3r-black-alpha-90: rgba(0, 0, 0, 0.9);     /* 90% Black */
  
  /* ─────────────────────────────────────────────────────────────────────────
     GREY SPECTRUM - UI Elements & Typography (8-shade system)
     ───────────────────────────────────────────────────────────────────────── */
  
  --v4d3r-grey-darkest: #1A1A1A;       /* Near Black - Main background */
  --v4d3r-grey-darker: #2A2A2A;        /* Darker Grey - UI backgrounds */
  --v4d3r-grey-dark: #3A3A3A;          /* Dark Grey - Borders, separators */
  --v4d3r-grey-medium-dark: #4A4A4A;   /* Medium-Dark Grey - Inactive elements */
  --v4d3r-grey-medium: #606060;        /* Medium Grey - Disabled states */
  --v4d3r-grey: #808080;               /* Silver Grey - Muted text */
  --v4d3r-grey-light: #C0C0C0;         /* Light Silver - Normal text ✓ WCAG AA */
  --v4d3r-grey-lighter: #D0D0D0;       /* Lighter Grey - Emphasis text */
  --v4d3r-grey-lightest: #E0E0E0;      /* Very Light Grey - Maximum emphasis */
  
  /* Grey Variants - For subtle overlays */
  --v4d3r-grey-alpha-10: rgba(192, 192, 192, 0.1);  /* 10% Light Silver */
  --v4d3r-grey-alpha-20: rgba(192, 192, 192, 0.2);  /* 20% Light Silver */
  --v4d3r-grey-alpha-30: rgba(192, 192, 192, 0.3);  /* 30% Light Silver */
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.2 OBSIDIAN CORE VARIABLE OVERRIDES
   Maps V4D3R palette to Obsidian's native CSS variables
   ══════════════════════════════════════════════════════════════════════════ */

.theme-dark {
  /* ─── BACKGROUND COLORS ─── */
  --background-primary: var(--v4d3r-grey-darkest);           /* Main background */
  --background-primary-alt: var(--v4d3r-grey-darker);        /* Sidebar background */
  --background-secondary: var(--v4d3r-grey-darker);          /* Secondary panels */
  --background-secondary-alt: var(--v4d3r-grey-dark);        /* Alternate panels */
  --background-modifier-border: var(--v4d3r-grey-dark);      /* Borders */
  --background-modifier-form-field: var(--v4d3r-grey-darker);/* Input fields */
  --background-modifier-form-field-highlighted: var(--v4d3r-grey-dark); /* Active inputs */
  --background-modifier-box-shadow: var(--v4d3r-black-alpha-50); /* Shadows */
  --background-modifier-success: var(--v4d3r-red-bright);    /* Success states */
  --background-modifier-error: var(--v4d3r-red-accent);      /* Error states */
  --background-modifier-error-hover: var(--v4d3r-red-dark);  /* Error hover */
  --background-modifier-cover: var(--v4d3r-black-alpha-70);  /* Modal overlays */
  
  /* ─── TEXT COLORS ─── */
  --text-normal: var(--v4d3r-grey-light);                    /* Normal text ✓ 7.2:1 */
  --text-muted: var(--v4d3r-grey);                           /* Muted text ✓ 4.6:1 */
  --text-faint: var(--v4d3r-grey-medium);                    /* Faint text */
  --text-error: var(--v4d3r-red-bright);                     /* Error text */
  --text-accent: var(--v4d3r-red-primary);                   /* Accent text */
  --text-accent-hover: var(--v4d3r-red-bright);              /* Accent hover */
  --text-selection: var(--v4d3r-red-alpha-30);               /* Text selection */
  --text-on-accent: var(--v4d3r-grey-lightest);              /* Text on red bg */
  
  /* ─── INTERACTIVE COLORS ─── */
  --interactive-normal: var(--v4d3r-grey-dark);              /* Normal state */
  --interactive-hover: var(--v4d3r-grey-medium-dark);        /* Hover state */
  --interactive-accent: var(--v4d3r-red-primary);            /* Accent elements */
  --interactive-accent-hover: var(--v4d3r-red-bright);       /* Accent hover */
  --interactive-accent-rgb: 220, 20, 60;                     /* RGB for opacity */
  --interactive-success: var(--v4d3r-red-bright);            /* Success actions */
  
  /* ─── SCROLLBAR ─── */
  --scrollbar-bg: var(--v4d3r-grey-darker);                  /* Scrollbar track */
  --scrollbar-thumb-bg: var(--v4d3r-grey-medium-dark);       /* Scrollbar thumb */
  --scrollbar-active-thumb-bg: var(--v4d3r-red-dark);        /* Active thumb */
  
  /* ─── HIGHLIGHTING ─── */
  --text-highlight-bg: var(--v4d3r-red-alpha-20);            /* Highlight bg */
  --text-highlight-bg-active: var(--v4d3r-red-alpha-30);     /* Active highlight */
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.3 TYPOGRAPHY SYSTEM - JetBrains Mono Light
   ══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─── FONT FAMILIES ─── */
  --font-text: "JetBrains Mono", "Courier New", Consolas, monospace;
  --font-monospace: "JetBrains Mono", "Courier New", Consolas, monospace;
  --font-interface: "JetBrains Mono", "Courier New", Consolas, monospace;
  --font-editor: "JetBrains Mono", "Courier New", Consolas, monospace;
  
  /* ─── FONT WEIGHTS ─── */
  --font-weight-thin: 100;           /* Ultra-light (original setting) */
  --font-weight-light: 300;          /* Light (RECOMMENDED for readability) */
  --font-weight-normal: 400;         /* Normal/Regular */
  --font-weight-medium: 500;         /* Medium */
  --font-weight-bold: 700;           /* Bold */
  
  /* Active weight - Change this to adjust global font weight */
  --v4d3r-base-font-weight: var(--font-weight-light); /* ← Using 300 (Light) */
  
  /* ─── FONT SIZES ─── */
  --v4d3r-base-font-size: 16px;      /* Base size for UI and content */
  --font-text-size: var(--v4d3r-base-font-size);
  --font-ui-small: 13px;             /* Small UI elements */
  --font-ui-medium: 14px;            /* Medium UI elements */
  --font-ui-large: 16px;             /* Large UI elements */
  
  /* Editor font sizes */
  --font-editor-size: var(--v4d3r-base-font-size);
  --font-smallest: 12px;
  --font-smaller: 13px;
  --font-small: 14px;
  
  /* ─── HEADING SIZES ─── */
  --h1-size: 2.0em;                  /* 32px at 16px base */
  --h2-size: 1.75em;                 /* 28px */
  --h3-size: 1.5em;                  /* 24px */
  --h4-size: 1.25em;                 /* 20px */
  --h5-size: 1.125em;                /* 18px */
  --h6-size: 1.0em;                  /* 16px */
  
  --h1-weight: var(--font-weight-bold);
  --h2-weight: var(--font-weight-bold);
  --h3-weight: var(--font-weight-medium);
  --h4-weight: var(--font-weight-medium);
  --h5-weight: var(--font-weight-normal);
  --h6-weight: var(--font-weight-normal);
  
  /* ─── LINE HEIGHTS ─── */
  --line-height-tight: 1.3;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;
  
  /* Active line heights */
  --v4d3r-line-height-ui: var(--line-height-tight);
  --v4d3r-line-height-content: var(--line-height-normal);
  --v4d3r-line-height-code: var(--line-height-tight);
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.4 SPACING & LAYOUT SYSTEM
   ══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─── SPACING SCALE (8px base unit) ─── */
  --v4d3r-space-xs: 4px;             /* Extra small - tight spacing */
  --v4d3r-space-sm: 8px;             /* Small - compact spacing */
  --v4d3r-space-md: 16px;            /* Medium - default spacing */
  --v4d3r-space-lg: 24px;            /* Large - generous spacing */
  --v4d3r-space-xl: 32px;            /* Extra large - section spacing */
  --v4d3r-space-2xl: 48px;           /* 2X large - major sections */
  --v4d3r-space-3xl: 64px;           /* 3X large - page-level spacing */
  
  /* ─── BORDER RADIUS ─── */
  --v4d3r-radius-sm: 4px;            /* Small radius - subtle rounding */
  --v4d3r-radius-md: 6px;            /* Medium radius - default */
  --v4d3r-radius-lg: 8px;            /* Large radius - prominent elements */
  --v4d3r-radius-xl: 12px;           /* Extra large - cards, panels */
  --v4d3r-radius-2xl: 16px;          /* 2X large - major components */
  --v4d3r-radius-full: 9999px;       /* Full radius - circles, pills */
  
  /* Obsidian native radius overrides */
  --radius-s: var(--v4d3r-radius-sm);
  --radius-m: var(--v4d3r-radius-md);
  --radius-l: var(--v4d3r-radius-lg);
  --radius-xl: var(--v4d3r-radius-xl);
  
  /* ─── BORDER WIDTHS ─── */
  --v4d3r-border-thin: 1px;          /* Thin border - subtle separation */
  --v4d3r-border-normal: 2px;        /* Normal border - standard */
  --v4d3r-border-thick: 3px;         /* Thick border - emphasis */
  --v4d3r-border-extra: 4px;         /* Extra thick - strong emphasis */
  
  /* ─── SHADOWS ─── */
  --v4d3r-shadow-sm: 0 2px 4px var(--v4d3r-black-alpha-50);
  --v4d3r-shadow-md: 0 4px 8px var(--v4d3r-black-alpha-50);
  --v4d3r-shadow-lg: 0 8px 16px var(--v4d3r-black-alpha-70);
  --v4d3r-shadow-xl: 0 12px 24px var(--v4d3r-black-alpha-70);
  
  /* Red glow shadows */
  --v4d3r-shadow-red-sm: 0 0 8px var(--v4d3r-red-alpha-30);
  --v4d3r-shadow-red-md: 0 0 12px var(--v4d3r-red-alpha-50);
  --v4d3r-shadow-red-lg: 0 0 16px var(--v4d3r-red-alpha-50);
  
  /* ─── Z-INDEX LAYERS ─── */
  --v4d3r-z-base: 0;                 /* Base layer */
  --v4d3r-z-dropdown: 100;           /* Dropdowns */
  --v4d3r-z-sticky: 200;             /* Sticky elements */
  --v4d3r-z-fixed: 300;              /* Fixed elements */
  --v4d3r-z-modal-backdrop: 400;     /* Modal backdrop */
  --v4d3r-z-modal: 500;              /* Modal content */
  --v4d3r-z-popover: 600;            /* Popovers */
  --v4d3r-z-tooltip: 700;            /* Tooltips */
  --v4d3r-z-notification: 800;       /* Notifications */
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.5 ANIMATION & TRANSITION SYSTEM
   ══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─── TIMING DURATIONS ─── */
  --v4d3r-transition-instant: 50ms;   /* Instant - immediate feedback */
  --v4d3r-transition-fast: 150ms;     /* Fast - quick transitions */
  --v4d3r-transition-normal: 250ms;   /* Normal - default speed */
  --v4d3r-transition-slow: 400ms;     /* Slow - deliberate animations */
  --v4d3r-transition-slower: 600ms;   /* Slower - emphasis animations */
  
  /* ─── EASING FUNCTIONS ─── */
  --v4d3r-ease-default: cubic-bezier(0.4, 0, 0.2, 1);      /* Default easing */
  --v4d3r-ease-in: cubic-bezier(0.4, 0, 1, 1);             /* Ease in */
  --v4d3r-ease-out: cubic-bezier(0, 0, 0.2, 1);            /* Ease out */
  --v4d3r-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);       /* Ease in-out */
  --v4d3r-ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55); /* Bounce */
  --v4d3r-ease-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);   /* Smooth */
  
  /* ─── COMMON TRANSITION COMBINATIONS ─── */
  --v4d3r-transition-colors: color var(--v4d3r-transition-fast) var(--v4d3r-ease-default),
                             background-color var(--v4d3r-transition-fast) var(--v4d3r-ease-default),
                             border-color var(--v4d3r-transition-fast) var(--v4d3r-ease-default);
  
  --v4d3r-transition-transform: transform var(--v4d3r-transition-normal) var(--v4d3r-ease-default);
  
  --v4d3r-transition-opacity: opacity var(--v4d3r-transition-normal) var(--v4d3r-ease-default);
  
  --v4d3r-transition-shadow: box-shadow var(--v4d3r-transition-normal) var(--v4d3r-ease-default);
  
  --v4d3r-transition-all: all var(--v4d3r-transition-normal) var(--v4d3r-ease-default);
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.6 SPECIAL EFFECTS VARIABLES
   ══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─── GLASSMORPHISM ─── */
  --v4d3r-glass-blur: 12px;                  /* Backdrop blur intensity */
  --v4d3r-glass-opacity: 0.7;                /* Glass opacity */
  --v4d3r-glass-border: 1px solid var(--v4d3r-grey-alpha-20);
  --v4d3r-glass-background: var(--v4d3r-black-alpha-50);
  
  /* ─── GLOW EFFECTS ─── */
  --v4d3r-glow-intensity-low: 0 0 10px;      /* Subtle glow */
  --v4d3r-glow-intensity-medium: 0 0 15px;   /* Medium glow */
  --v4d3r-glow-intensity-high: 0 0 20px;     /* Intense glow */
  
  /* ─── NEON EFFECTS ─── */
  --v4d3r-neon-red: 0 0 10px var(--v4d3r-red-primary),
                    0 0 20px var(--v4d3r-red-alpha-50),
                    0 0 30px var(--v4d3r-red-alpha-30);
  
  /* ─── GRADIENT OVERLAYS ─── */
  --v4d3r-gradient-red-to-black: linear-gradient(135deg, 
                                  var(--v4d3r-red-dark) 0%, 
                                  var(--v4d3r-black) 100%);
  
  --v4d3r-gradient-grey-to-black: linear-gradient(135deg, 
                                   var(--v4d3r-grey-darker) 0%, 
                                   var(--v4d3r-black) 100%);
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.7 ACCESSIBILITY SETTINGS
   ══════════════════════════════════════════════════════════════════════════ */



/* ─── High Contrast Support ─── */
@media (prefers-contrast: high) {
  :root {
    --text-normal: var(--v4d3r-grey-lightest);       /* Brighter text */
    --background-primary: var(--v4d3r-black);        /* Deeper background */
    --v4d3r-border-normal: 2px;                      /* Thicker borders */
    --interactive-accent: var(--v4d3r-red-accent);   /* Stronger accent */
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   1.8 MOBILE RESPONSIVE BREAKPOINTS
   ══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─── Breakpoint Values ─── */
  --v4d3r-breakpoint-mobile: 768px;      /* Mobile devices */
  --v4d3r-breakpoint-tablet: 1024px;     /* Tablets */
  --v4d3r-breakpoint-desktop: 1440px;    /* Desktop */
  
  /* ─── Mobile Adjustments ─── */
  --v4d3r-mobile-touch-target: 44px;     /* Minimum touch target size */
  --v4d3r-mobile-font-scale: 1.0;        /* Font scaling on mobile */
}

/* Mobile-specific variable overrides */
@media (max-width: 768px) {
  :root {
    --v4d3r-base-font-size: 15px;        /* Slightly smaller on mobile */
    --v4d3r-space-md: 12px;              /* Tighter spacing */
    --v4d3r-space-lg: 16px;
    --v4d3r-space-xl: 24px;
  }
}

















/* ═══════════════════════════════════════════════════════════════════════════
   1.9 WCAG CONTRAST VALIDATION COMMENTS
   
   All color combinations have been validated for WCAG 2.1 AA compliance
   (minimum 4.5:1 for normal text, 3:1 for large text)
   ══════════════════════════════════════════════════════════════════════════ */

/*
CONTRAST VALIDATION RESULTS:

✓ PASS - Normal Text (14-18px):
  - #C0C0C0 on #1A1A1A = 7.2:1 (AAA)
  - #808080 on #1A1A1A = 4.6:1 (AA)
  - #DC143C on #1A1A1A = 5.1:1 (AA)

✓ PASS - Large Text (18px+, or 14px+ bold):
  - #FF6B6B on #1A1A1A = 6.8:1 (AAA)
  - #8B0000 on #C0C0C0 = 4.2:1 (AA)

✓ PASS - UI Components (3:1 minimum):
  - #DC143C on #2A2A2A = 4.8:1 (AAA)
  - #8B0000 on #3A3A3A = 3.4:1 (AA)

⚠ NOTE: All red accent colors on grey backgrounds meet AA standards.
         White (#FFFFFF) or near-white (#E0E0E0) should be used for
         text on pure red backgrounds to ensure readability.
*/

/* ═══════════════════════════════════════════════════════════════════════════
   END OF FOUNDATION VARIABLES
   
   NEXT PHASE: Core UI Components will use these variables throughout.
   All subsequent CSS files will reference this variable system.
   ══════════════════════════════════════════════════════════════════════════ */
   /*
   ═══════════════════════════════════════════════════════════════════════════════
    V4D3R CRIMSON THEME
    
    Version: 1.0.0
    Author: Pur3v4d3r
    Description: Production-ready dark theme - Red, Black, Grey palette
    Obsidian Version: 1.5.0+
   ═══════════════════════════════════════════════════════════════════════════════
   */
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 1: FOUNDATION VARIABLES
      ══════════════════════════════════════════════════════════════════════════ */
   
   .theme-dark,
   :root {
     /* ─── RED SPECTRUM ─── */
     --v4d3r-red-primary: #DC143C;
     --v4d3r-red-dark: #8B0000;
     --v4d3r-red-bright: #FF6B6B;
     --v4d3r-red-accent: #FF0000;
     --v4d3r-red-deep: #660000;
     
     --v4d3r-red-alpha-10: rgba(220, 20, 60, 0.1);
     --v4d3r-red-alpha-15: rgba(220, 20, 60, 0.15);
     --v4d3r-red-alpha-20: rgba(220, 20, 60, 0.2);
     --v4d3r-red-alpha-30: rgba(220, 20, 60, 0.3);
     --v4d3r-red-alpha-50: rgba(220, 20, 60, 0.5);
     
     /* ─── BLACK SPECTRUM ─── */
     --v4d3r-black: #000000;
     --v4d3r-black-soft: #0A0A0A;
     --v4d3r-black-alpha-50: rgba(0, 0, 0, 0.5);
     --v4d3r-black-alpha-70: rgba(0, 0, 0, 0.7);
     --v4d3r-black-alpha-90: rgba(0, 0, 0, 0.9);
     
     /* ─── GREY SPECTRUM ─── */
     --v4d3r-grey-darkest: #1A1A1A;
     --v4d3r-grey-darker: #2A2A2A;
     --v4d3r-grey-dark: #3A3A3A;
     --v4d3r-grey-medium-dark: #4A4A4A;
     --v4d3r-grey-medium: #606060;
     --v4d3r-grey: #808080;
     --v4d3r-grey-light: #C0C0C0;
     --v4d3r-grey-lighter: #D0D0D0;
     --v4d3r-grey-lightest: #E0E0E0;
     
     --v4d3r-grey-alpha-10: rgba(192, 192, 192, 0.1);
     --v4d3r-grey-alpha-20: rgba(192, 192, 192, 0.2);
     --v4d3r-grey-alpha-30: rgba(192, 192, 192, 0.3);
     
     /* ─── TYPOGRAPHY ─── */
     --font-text: "JetBrains Mono", "Courier New", Consolas, monospace;
     --font-monospace: "JetBrains Mono", "Courier New", Consolas, monospace;
     --font-interface: "JetBrains Mono", "Courier New", Consolas, monospace;
     --font-editor: "JetBrains Mono", "Courier New", Consolas, monospace;
     
     --font-weight-thin: 100;
     --font-weight-light: 300;
     --font-weight-normal: 400;
     --font-weight-medium: 500;
     --font-weight-bold: 700;
     --v4d3r-base-font-weight: var(--font-weight-thin);
     
     --v4d3r-base-font-size: 16px;
     --font-text-size: var(--v4d3r-base-font-size);
     
     --h1-size: 2.0em;
     --h2-size: 1.75em;
     --h3-size: 1.5em;
     --h4-size: 1.25em;
     --h5-size: 1.125em;
     --h6-size: 1.0em;
     
     --line-height-tight: 1.3;
     --line-height-normal: 1.6;
     --line-height-relaxed: 1.8;
     
     /* ─── SPACING ─── */
     --v4d3r-space-xs: 4px;
     --v4d3r-space-sm: 8px;
     --v4d3r-space-md: 16px;
     --v4d3r-space-lg: 24px;
     --v4d3r-space-xl: 32px;
     --v4d3r-space-2xl: 48px;
     --v4d3r-space-3xl: 64px;
     
     --v4d3r-radius-sm: 4px;
     --v4d3r-radius-md: 6px;
     --v4d3r-radius-lg: 8px;
     --v4d3r-radius-xl: 12px;
     --v4d3r-radius-2xl: 16px;
     --v4d3r-radius-full: 9999px;
     
     --radius-s: var(--v4d3r-radius-sm);
     --radius-m: var(--v4d3r-radius-md);
     --radius-l: var(--v4d3r-radius-lg);
     --radius-xl: var(--v4d3r-radius-xl);
     
     --v4d3r-border-thin: 1px;
     --v4d3r-border-normal: 2px;
     --v4d3r-border-thick: 3px;
     
     /* ─── SHADOWS ─── */
     --v4d3r-shadow-sm: 0 2px 4px var(--v4d3r-black-alpha-50);
     --v4d3r-shadow-md: 0 4px 8px var(--v4d3r-black-alpha-50);
     --v4d3r-shadow-lg: 0 8px 16px var(--v4d3r-black-alpha-70);
     --v4d3r-shadow-xl: 0 12px 24px var(--v4d3r-black-alpha-70);
     --v4d3r-shadow-red-sm: 0 0 8px var(--v4d3r-red-alpha-30);
     --v4d3r-shadow-red-md: 0 0 12px var(--v4d3r-red-alpha-50);
     --v4d3r-shadow-red-lg: 0 0 16px var(--v4d3r-red-alpha-50);
     
     /* ─── ANIMATIONS ─── */
     --v4d3r-transition-instant: 50ms;
     --v4d3r-transition-fast: 100ms;
     --v4d3r-transition-normal: 250ms;
     --v4d3r-transition-slow: 400ms;
     
     --v4d3r-ease-default: cubic-bezier(0.4, 0, 0.2, 1);
     --v4d3r-ease-in: cubic-bezier(0.4, 0, 1, 1);
     --v4d3r-ease-out: cubic-bezier(0, 0, 0.2, 1);
     
     /* ─── OBSIDIAN CORE OVERRIDES ─── */
     --background-primary: var(--v4d3r-grey-darkest);
     --background-primary-alt: var(--v4d3r-grey-darker);
     --background-secondary: var(--v4d3r-grey-darker);
     --background-secondary-alt: var(--v4d3r-grey-dark);
     --background-modifier-border: var(--v4d3r-grey-dark);
     --background-modifier-form-field: var(--v4d3r-grey-darker);
     --background-modifier-form-field-highlighted: var(--v4d3r-grey-dark);
     --background-modifier-box-shadow: var(--v4d3r-black-alpha-50);
     --background-modifier-success: var(--v4d3r-red-bright);
     --background-modifier-error: var(--v4d3r-red-accent);
     --background-modifier-error-hover: var(--v4d3r-red-dark);
     --background-modifier-cover: var(--v4d3r-black-alpha-70);
     
     --text-normal: var(--v4d3r-grey-light);
     --text-muted: var(--v4d3r-grey);
     --text-faint: var(--v4d3r-grey-medium);
     --text-error: var(--v4d3r-red-bright);
     --text-accent: var(--v4d3r-red-primary);
     --text-accent-hover: var(--v4d3r-red-bright);
     --text-selection: var(--v4d3r-red-alpha-30);
     --text-on-accent: var(--v4d3r-grey-lightest);
     
     --interactive-normal: var(--v4d3r-grey-dark);
     --interactive-hover: var(--v4d3r-grey-medium-dark);
     --interactive-accent: var(--v4d3r-red-primary);
     --interactive-accent-hover: var(--v4d3r-red-bright);
     --interactive-accent-rgb: 220, 20, 60;
     --interactive-success: var(--v4d3r-red-bright);
     
     --scrollbar-bg: var(--v4d3r-grey-darker);
     --scrollbar-thumb-bg: var(--v4d3r-grey-medium-dark);
     --scrollbar-active-thumb-bg: var(--v4d3r-red-dark);
     
     --text-highlight-bg: var(--v4d3r-red-alpha-20);
     --text-highlight-bg-active: var(--v4d3r-red-alpha-30);
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 2: BASE TYPOGRAPHY
      ══════════════════════════════════════════════════════════════════════════ */
   
   body {
     font-family: var(--font-text) !important;
     font-weight: var(--v4d3r-base-font-weight) !important;
     font-size: var(--v4d3r-base-font-size) !important;
     -webkit-font-smoothing: antialiased !important;
     -moz-osx-font-smoothing: grayscale !important;
   }
   
   /* Editor */
   .markdown-source-view,
   .markdown-source-view.mod-cm6,
   .cm-editor,
   .cm-content,
   .cm-scroller,
   .cm-line {
     font-family: var(--font-editor) !important;
     font-weight: var(--v4d3r-base-font-weight) !important;
   }
   
   /* Preview/Reading Mode */
   .markdown-preview-view,
   .markdown-rendered {
     font-family: var(--font-text) !important;
     font-weight: var(--v4d3r-base-font-weight) !important;
   }
   
   /* Interface */
   .workspace,
   .nav-file-title,
   .nav-folder-title,
   .search-result-file-title,
   .workspace-tab-header-inner,
   .titlebar,
   .status-bar {
     font-family: var(--font-interface) !important;
     font-weight: var(--v4d3r-base-font-weight) !important;
   }
   
   /* Code */
   code,
   pre,
   .cm-inline-code,
   .markdown-preview-view code {
     font-family: var(--font-monospace) !important;
     font-weight: var(--v4d3r-base-font-weight) !important;
   }
 
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 3: WORKSPACE & CANVAS
      ══════════════════════════════════════════════════════════════════════════ */
   
   .workspace {
     background-color: var(--v4d3r-grey-darkest) !important;
   }
   
   .workspace-split.mod-root {
     background-color: var(--v4d3r-grey-darkest) !important;
   }
   
   .workspace-leaf {
     background-color: var(--v4d3r-grey-darkest) !important;
     border-radius: var(--v4d3r-radius-lg) !important;
   }
   
   .workspace-leaf-content {
     background-color: var(--v4d3r-grey-darkest) !important;
   }
   

   /* ═══════════════════════════════════════════════════════════════════════════
      PART 5: SIDEBARS (Left & Right Panels)
      ══════════════════════════════════════════════════════════════════════════ */

   .workspace-tab-header:hover {
     color: var(--v4d3r-grey-light) !important;
     background-color: var(--v4d3r-grey-medium-dark) !important;
   }
   
   .workspace-tab-header.is-active {
     color: var(--v4d3r-red-bright) !important;
     background-color: var(--v4d3r-red-alpha-20) !important;
     border-bottom: 2px solid var(--v4d3r-red-primary) !important;
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 6: FILE EXPLORER
      ══════════════════════════════════════════════════════════════════════════ */
   
   .nav-files-container {
     padding: 10px 6px !important;
     font-family: var(--font-interface) !important;
     background-color: transparent !important;
   }
   
   .nav-folder-title,
   .nav-file-title {
     color: var(--v4d3r-grey-light) !important;
     padding: 4px 8px !important;
     border-radius: var(--v4d3r-radius-sm) !important;
     transition: background-color var(--v4d3r-transition-fast) var(--v4d3r-ease-default),
                 color var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   .nav-folder-title:hover,
   .nav-file-title:hover {
     background-color: var(--v4d3r-grey-dark) !important;
     color: var(--v4d3r-grey-lighter) !important;
   }
   
   .nav-file-title.is-active {
     background-color: var(--v4d3r-red-alpha-20) !important;
     color: var(--v4d3r-red-bright) !important;
     border-left: var(--v4d3r-border-thick) solid var(--v4d3r-red-primary) !important;
   }
   
   /* Root Folder Styling */
   .nav-folder-title[data-path="00-inbox"] {
     color: var(--v4d3r-grey-light) !important;
     font-weight: 300 !important;
     background: var(--v4d3r-red-alpha-10) !important;
     padding: 5px 8px !important;
     border-right: 3px solid var(--v4d3r-red-dark) !important;
     font-size: 18px !important;
   }
   
   .nav-folder-title[data-path="00-inbox"]::before {
     content: "📥 ";
     margin-right: 6px;
   }
   
   .nav-folder-title[data-path="000_databsae"],
   .nav-folder-title[data-path="01_daily-notes"],
   .nav-folder-title[data-path="02-projects"],
   .nav-folder-title[data-path="03-notes"],
   .nav-folder-title[data-path="04-library"],
   .nav-folder-title[data-path="05-tasks-&-reviews"],
   .nav-folder-title[data-path="06-dashboards"],
   .nav-folder-title[data-path="07-mocs"] {
     color: var(--v4d3r-grey-light) !important;
     font-weight: 700 !important;
     background: var(--v4d3r-red-alpha-10) !important;
     padding: 5px 8px !important;
     border-right: 3px solid var(--v4d3r-red-dark) !important;
     font-size: 18px !important;
   }
   
   .nav-folder-title[data-path="000_databsae"]::before { content: "💾 "; margin-right: 6px; }
   .nav-folder-title[data-path="01_daily-notes"]::before { content: "📅 "; margin-right: 6px; }
   .nav-folder-title[data-path="02-projects"]::before { content: "🔬 "; margin-right: 6px; }
   .nav-folder-title[data-path="03-notes"]::before { content: "📄 "; margin-right: 6px; }
   .nav-folder-title[data-path="04-library"]::before { content: "📚 "; margin-right: 6px; }
   .nav-folder-title[data-path="05-tasks-&-reviews"]::before { content: "✅ "; margin-right: 6px; }
   .nav-folder-title[data-path="06-dashboards"]::before { content: "📊 "; margin-right: 6px; }
   .nav-folder-title[data-path="07-mocs"]::before { content: "🗺️ "; margin-right: 6px; }
   
   /* System Folders */
   .nav-folder-title[data-path="99-archive"],
   .nav-folder-title[data-path="99-system"],
   .nav-folder-title[data-path="99-scripts"],
   .nav-folder-title[data-path="00-meta"] {
     color: var(--v4d3r-grey-light) !important;
     background: rgba(49, 49, 49, 0.12) !important;
     font-weight: 600 !important;
     opacity: 0.85 !important;
     font-size: 18px !important;
     border-right: 3px solid var(--v4d3r-red-dark) !important;
     padding: 4px 8px !important;
   }
   
   .nav-folder-title[data-path="99-archive"]::before { content: "🗄️ "; margin-right: 6px; }
   .nav-folder-title[data-path="99-system"]::before { content: "⚙️ "; margin-right: 6px; }
   .nav-folder-title[data-path="99-scripts"]::before { content: "👾 "; margin-right: 6px; }
   .nav-folder-title[data-path="00-meta"]::before { content: "♾️ "; margin-right: 6px; }

  

   /* ═══════════════════════════════════════════════════════════════════════════
      PART 8: STATUS BAR
      ══════════════════════════════════════════════════════════════════════════ */
   
   .status-bar {
     background-color: var(--v4d3r-grey-darker) !important;
     border-top: 1px solid var(--v4d3r-grey-dark) !important;
     color: var(--v4d3r-grey) !important;
     font-size: 12px !important;
     padding: var(--v4d3r-space-xs) var(--v4d3r-space-md) !important;
     box-shadow: 0 -2px 8px var(--v4d3r-black-alpha-50) !important;
   }
   
   .status-bar-item {
     color: var(--v4d3r-grey) !important;
     padding: var(--v4d3r-space-xs) var(--v4d3r-space-sm) !important;
     border-radius: var(--v4d3r-radius-sm) !important;
     transition: all var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   .status-bar-item:hover {
     color: var(--v4d3r-red-bright) !important;
     background-color: var(--v4d3r-red-alpha-15) !important;
     box-shadow: var(--v4d3r-shadow-red-sm) !important;
   }
 
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 10: MODALS & POPOVERS
      ══════════════════════════════════════════════════════════════════════════ */
   
   .modal-container {
     background-color: var(--v4d3r-black-alpha-70) !important;
     backdrop-filter: blur(4px) !important;
   }
   
   .modal {
     background-color: var(--v4d3r-grey-darker) !important;
     border: 1px solid var(--v4d3r-grey-dark) !important;
     border-radius: var(--v4d3r-radius-xl) !important;
     box-shadow: var(--v4d3r-shadow-xl), 0 0 48px var(--v4d3r-red-alpha-30) !important;
   }
   
   .modal-title {
     color: var(--v4d3r-grey-lightest) !important;
     font-weight: var(--font-weight-bold) !important;
     border-bottom: 1px solid var(--v4d3r-grey-dark) !important;
     padding-bottom: var(--v4d3r-space-sm) !important;
   }
   
   .modal-content {
     color: var(--v4d3r-grey-light) !important;
   }
   
   .modal-close-button {
     color: var(--v4d3r-grey) !important;
     transition: all var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   .modal-close-button:hover {
     color: var(--v4d3r-red-accent) !important;
     background-color: var(--v4d3r-red-alpha-20) !important;
   }
   
   /* Popovers */
   .popover,
   .hover-popover,
   .menu {
     background-color: var(--v4d3r-grey-darker) !important;
     border: 1px solid var(--v4d3r-grey-dark) !important;
     border-radius: var(--v4d3r-radius-lg) !important;
     box-shadow: var(--v4d3r-shadow-lg), 0 0 24px var(--v4d3r-red-alpha-20) !important;
   }
   
   .menu-item {
     color: var(--v4d3r-grey-light) !important;
     padding: var(--v4d3r-space-sm) var(--v4d3r-space-md) !important;
     border-radius: var(--v4d3r-radius-sm) !important;
     transition: all var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   .menu-item:hover {
     background-color: var(--v4d3r-red-alpha-15) !important;
     color: var(--v4d3r-red-bright) !important;
   }
   
   .menu-item.is-selected {
     background-color: var(--v4d3r-red-alpha-20) !important;
     color: var(--v4d3r-red-primary) !important;
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 11: BUTTONS & INTERACTIVE ELEMENTS
      ══════════════════════════════════════════════════════════════════════════ */
   
   .button,
   button {
     background-color: var(--v4d3r-grey-dark) !important;
     color: var(--v4d3r-grey-light) !important;
     border: 1px solid var(--v4d3r-grey-medium-dark) !important;
     border-radius: var(--v4d3r-radius-md) !important;
     padding: var(--v4d3r-space-sm) var(--v4d3r-space-md) !important;
     font-weight: var(--font-weight-normal) !important;
     transition: all var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   .button:hover,
   button:hover {
     background-color: var(--v4d3r-grey-medium-dark) !important;
     color: var(--v4d3r-grey-lighter) !important;
     border-color: var(--v4d3r-grey) !important;
     transform: translateY(-2px) !important;
     box-shadow: var(--v4d3r-shadow-md) !important;
   }
   
   .mod-cta,
   .button.mod-cta {
     background-color: var(--v4d3r-red-primary) !important;
     color: var(--v4d3r-grey-lightest) !important;
     border-color: var(--v4d3r-red-dark) !important;
   }
   
   .mod-cta:hover,
   .button.mod-cta:hover {
     background-color: var(--v4d3r-red-bright) !important;
     box-shadow: var(--v4d3r-shadow-red-md) !important;
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 12: SCROLLBARS
      ══════════════════════════════════════════════════════════════════════════ */
   
   ::-webkit-scrollbar {
     width: 12px !important;
     height: 12px !important;
   }
   
   ::-webkit-scrollbar-track {
     background-color: var(--v4d3r-grey-darker) !important;
     border-radius: var(--v4d3r-radius-sm) !important;
   }
   
   ::-webkit-scrollbar-thumb {
     background-color: var(--v4d3r-red-accent) !important;
     border-radius: var(--v4d3r-radius-sm) !important;
     border: 2px solid var(--v4d3r-grey-darker) !important;
     transition: background-color var(--v4d3r-transition-fast) var(--v4d3r-ease-default) !important;
   }
   
   ::-webkit-scrollbar-thumb:hover {
     background-color: var(--v4d3r-red-dark) !important;
   }
   
   ::-webkit-scrollbar-thumb:active {
     background-color: var(--v4d3r-red-primary) !important;
   }
   
   /* ═══════════════════════════════════════════════════════════════════════════
      PART 13: SEARCH
      ══════════════════════════════════════════════════════════════════════════ */
   
   .search-input-container {
     background-color: var(--v4d3r-grey-dark) !important;
     border: 1px solid var(--v4d3r-grey-medium-dark) !important;
     border-radius: var(--v4d3r-radius-md) !important;
   }
   
   .search-input {
     color: var(--v4d3r-grey-light) !important;
     background-color: transparent !important;
   }
   
   .search-input::placeholder {
     color: var(--v4d3r-grey) !important;
   }
   
   .search-result-file-title {
     color: var(--v4d3r-grey-lighter) !important;
     font-weight: var(--font-weight-medium) !important;
   }
   
   .search-result-file-match {
     color: var(--v4d3r-grey-light) !important;
     background-color: var(--v4d3r-grey-darker) !important;
     border-left: 2px solid var(--v4d3r-red-dark) !important;
     padding: var(--v4d3r-space-xs) var(--v4d3r-space-sm) !important;
     margin: var(--v4d3r-space-xs) 0 !important;
   }
   
   .search-result-file-matched-text {
     background-color: var(--v4d3r-red-alpha-30) !important;
     color: var(--v4d3r-red-bright) !important;
     font-weight: var(--font-weight-bold) !important;
   }
   
   /* ─── Prevent Code Wrapping in Tables ─── */
   table code:not(pre code) {
     white-space: nowrap;
   }




/* ══════════════════════════════════════════════════════════
   INLINE CODE BLOCKS - Base Styling
   Applies to both editor and preview mode
   ══════════════════════════════════════════════════════════ */

.markdown-source-view.mod-cm6 .cm-inline-code,
.markdown-preview-view .inline-code,
.markdown-preview-view code:not(pre code),
.markdown-reading-view .inline-code,
.markdown-reading-view code:not(pre code) {
  /*Background-Transparentpurplewithdepth*/
  background-color: #5D58564D !important;
  /*30%opacitypurple*/
  text-transform: uppercase !important;
  /*Text-Brightcyanforcontrast*/
  color: rgb(255, 0, 0) !important;
  /*Cybercyan*//*Border-Blackoutline*/
  border: 3.20px solid #000000cc !important;
  /*Semi-transparentblack*/
  border-radius: 4px !important;
  /*Roundedcorners*//*Spacing-Minimalpaddingforinline display*/
  padding: 1.1px 1.1px !important;
  /*Font-Monospaceforcode*/font-family: 'Jetbrains Mono', var(--font-monospace-override), monospace !important;
  font-weight: 100 !important;
  /*Thinweight*/
  font-size: 0.95em !important;
  /*Slightlysmaller*//*Gloweffect-Purpleshadow*/
  box-shadow: 0 0 6px rgb(255, 0, 0);
  /*Softpurpleglow*//*Smoothtransitions*/
  transition: box-shadow 0.2s ease-in-out !important;
}

/* ══════════════════════════════════════════════════════════
   CLICK-TO-SELECT BEHAVIOR
   Enhanced interaction on hover
   ══════════════════════════════════════════════════════════ */

.markdown-source-view.mod-cm6 .cm-inline-code:hover,
.markdown-preview-view .inline-code:hover,
.markdown-preview-view code:not(pre code):hover,
.markdown-reading-view .inline-code:hover,
.markdown-reading-view code:not(pre code):hover {
  cursor: pointer !important;                 /* Pointer cursor */
  box-shadow: 0 0 12px rgb(255, 0, 0) !important;  /* Bright cyan glow */
    text-transform: capitalize !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   GLOWING BRACKETS SYSTEM
   File:    glowing-brackets-for-theme.css
   Version: 2.0.0
   Author:  Pur3v4d3r

   Coverage:
     ✓ Reading Mode  — [[wiki-links]]    via ::before/::after on .internal-link
     ✓ Reading Mode  — [dataview:: ]     via color-inheritance + pseudo-override
     ✓ Live Preview  — [[wiki-links]]    cursor ON line  → raw .cm-formatting spans
     ✓ Live Preview  — [[wiki-links]]    cursor OFF line → ::before/::after on link text
     ✓ Live Preview  — [dataview:: ]     via .cm-formatting-link (plugin widget)

   Why the old LP wiki-link approach failed:
     Obsidian uses CM6 Decoration.replace() to REMOVE [[/]] from the DOM when the
     cursor is not on the line. display:inline !important cannot restore replaced nodes.
     The fix: inject [[/]] as ::before/::after on the link TEXT span instead.
═══════════════════════════════════════════════════════════════════════════ */


/* ─── VARIABLES ───────────────────────────────────────────────────────────── */

:root {
  --gb-color:  #ffffff;
  --gb-shadow: 0 0 3px rgb(255, 0, 0), 0 0 6px rgb(255, 0, 0);
  --gb-filter: drop-shadow(0 0 3px rgb(255, 0, 0));
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 1  ·  READING MODE — [[wiki-link]] brackets
   ::before/::after injected onto the .internal-link anchor element.
   Works because reading mode is static HTML with .internal-link anchors.
═══════════════════════════════════════════════════════════════════════════ */

.markdown-reading-view .internal-link::before,
.markdown-preview-view .internal-link::before,
.markdown-rendered .internal-link::before {
  content: '[[' !important;
  display: inline !important;
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
  font-weight: bold !important;
}

.markdown-reading-view .internal-link::after,
.markdown-preview-view .internal-link::after,
.markdown-rendered .internal-link::after {
  content: ']]' !important;
  display: inline !important;
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
  font-weight: bold !important;
}


.markdown-source-view.mod-cm6 .cm-hmd-internal-link.cm-formatting-link {
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
  font-weight: bold !important;
  display: inline !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* Case B: folded link — inject via pseudo-elements on the link text span */
.markdown-source-view.mod-cm6 .cm-line:not(.cm-activeLine) .cm-hmd-internal-link:not(.cm-formatting)::before {
  content: '[[';
  color: var(--gb-color);
  text-shadow: var(--gb-shadow);
  font-weight: bold;
}

.markdown-source-view.mod-cm6 .cm-line:not(.cm-activeLine) .cm-hmd-internal-link:not(.cm-formatting)::after {
  content: ']]';
  color: var(--gb-color);
  text-shadow: var(--gb-shadow);
  font-weight: bold;
}



/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 2  ·  READING MODE — Dataview [key:: value] brackets

   Dataview HTML structure in reading mode:
     <span class="dataview inline-field">
       [  ← text node OR on .inline-field-standalone-value
       <span class="inline-field-key">key</span>
       <span class="inline-field-value">value</span>
       ]  ← text node OR pseudo-element
     </span>

   Strategy:
     1. Set color on the container — text nodes inherit it
     2. Override ::before/::after if Dataview generates brackets that way
     3. Reset ONLY .inline-field-key and .inline-field-value back to normal
        Do NOT reset .inline-field-standalone-value — its text nodes ARE the brackets
═══════════════════════════════════════════════════════════════════════════ */

/* 1. Container: bracket text-nodes inherit glow color.
      Targets both old Dataview (class="dataview inline-field")
      and new Dataview (class="inline-field" only). */
.markdown-reading-view .inline-field,
.markdown-preview-view .inline-field,
.markdown-rendered .inline-field {
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
}

/* 2. Reset key back to link color */
.markdown-reading-view .inline-field .inline-field-key,
.markdown-preview-view .inline-field .inline-field-key,
.markdown-rendered .inline-field .inline-field-key {
  color: var(--link-color) !important;
  text-shadow: none !important;
}

/* 3. Reset value back to normal text */
.markdown-reading-view .inline-field .inline-field-value,
.markdown-preview-view .inline-field .inline-field-value,
.markdown-rendered .inline-field .inline-field-value {
  color: var(--text-normal) !important;
  text-shadow: none !important;
}


/* ═══════════════════════════════════════════════════════════════════════════
   SECTION 3  ·  LIVE PREVIEW — [[wiki-link]] brackets

   CASE A — cursor IS on the line:
     Obsidian shows raw [[ ]] as .cm-formatting.cm-formatting-link spans.
     Color those directly. They are present in the DOM here.

   CASE B — cursor NOT on the line (folded/rendered state):
     Obsidian's InternalLinkPlugin calls Decoration.replace() on [[ ]] —
     those spans are REMOVED from the DOM. Cannot be un-hidden with CSS.
     The link TEXT span (.cm-hmd-internal-link without .cm-formatting) remains.
     Inject [[ ]] via ::before/::after, gated to :not(.cm-activeLine)
     so Case A brackets don't double up when the user edits that line.
═══════════════════════════════════════════════════════════════════════════ */

/* Case A: raw syntax (cursor on line) */
.markdown-source-view.mod-cm6 .cm-formatting.cm-formatting-link,
.markdown-source-view.mod-cm6 .cm-hmd-internal-link.cm-formatting,
.markdown-source-view.mod-cm6 .cm-line:not(.cm-activeLine) .cm-hmd-internal-link.cm-formatting {
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
  font-weight: bold !important;
  filter: var(--gb-filter) !important;
  opacity: 1 !important;
  display: inline !important;
  visibility: visible !important;
}
.markdown-source-view.mod-cm6 .cm-hmd-internal-link.cm-formatting-link {
  color: var(--gb-color) !important;
  text-shadow: var(--gb-shadow) !important;
  font-weight: bold !important;
  display: inline !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* Case B: folded link — inject via pseudo-elements on the link text span */
.markdown-source-view.mod-cm6 .cm-line:not(.cm-activeLine) .cm-hmd-internal-link:not(.cm-formatting)::before {
  content: '[[';
  color: var(--gb-color);
  text-shadow: var(--gb-shadow);
  font-weight: bold;
}

.markdown-source-view.mod-cm6 .cm-line:not(.cm-activeLine) .cm-hmd-internal-link:not(.cm-formatting)::after {
  content: ']]';
  color: var(--gb-color);
  text-shadow: var(--gb-shadow);
  font-weight: bold;
}





   /*
   ═══════════════════════════════════════════════════════════
    SNIPPET NAME: Pur3v4d3r's Advanced Code Block Customization
    Purpose: Professional code block styling with community features
    Author: Pur3v4d3r
    Date: 2025-12-13 (Fixed: 2025-12-28)
    Obsidian Version: 1.5.0+
    Features: Rounded corners, gradient glow borders, syntax highlighting
    Installation: Place in .obsidian/snippets/ and enable
    
    FIXES APPLIED:
    - Fixed all CSS syntax errors
    - Corrected malformed box-shadow declarations
    - Removed invalid JavaScript string methods from CSS
    - Cleaned up duplicate/conflicting rules
   ═══════════════════════════════════════════════════════════
   */
   
   /* ════════════════════════════════════════════════════════
      SECTION 1: READING/PREVIEW MODE
      ═══════════════════════════════════════════════════════ */
   
   .theme-dark .workspace-leaf-content .markdown-preview-view pre[class*="language-"],
   .theme-dark .workspace-leaf-content .markdown-preview-view pre,
   .theme-dark .markdown-preview-view pre[class*="language-"],
   .theme-dark .markdown-preview-view pre,
   .theme-dark .markdown-rendered pre {
     position: relative !important;
     background: linear-gradient(135deg, #ff00001d 0%, #0A0A0A 100%) !important;
     border: 2px solid rgba(255, 0, 0, 0.2) !important;
     border-radius: 15px !important;
     box-shadow: 8px 8px 15px rgba(255, 0, 0, 0.3) !important;
     padding: 20px !important;
     margin: 16px 0 !important;
     overflow-wrap: break-word !important;
     overflow: auto !important;
   }
   
   /* ════════════════════════════════════════════════════════
      SECTION 2: LIVE PREVIEW / SOURCE MODE (CM6)
      ═══════════════════════════════════════════════════════ */
   
   /* Base styling for ALL code block lines */
   .theme-dark .workspace-leaf-content .markdown-source-view.mod-cm6 .HyperMD-codeblock,
   .theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-codeblock,
   .theme-dark .markdown-source-view.mod-cm6 .HyperMD-codeblock {
     background: linear-gradient(135deg, #77777728 0%, #0A0A0A 100%) !important;
     padding: 0 12px !important;
     margin: 0 !important;
     border-radius: 0 !important;
     box-shadow: inset 3px 0 0 #ff4800 !important;
   }
   
   /* FIRST line of code block - top rounded corners + top border */
   .theme-dark .workspace-leaf-content .markdown-source-view.mod-cm6 .HyperMD-codeblock-begin,
   .theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-codeblock-begin,
   .theme-dark .markdown-source-view.mod-cm6 .HyperMD-codeblock-begin {
     border-radius: 12px 12px 0 0 !important;
     padding-top: 16px !important;
     margin-top: 8px !important;
     box-shadow: 
       inset 2px 0 0 #ff4800,
       inset 0 2px 0 #ff4800,
       0 4px 75px rgba(255, 0, 0, 0.2) !important;
   }
   
   /* LAST line of code block - bottom rounded corners + bottom border */
   .theme-dark .workspace-leaf-content .markdown-source-view.mod-cm6 .HyperMD-codeblock-end,
   .theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-codeblock-end,
   .theme-dark .markdown-source-view.mod-cm6 .HyperMD-codeblock-end {
     border-radius: 0 0 12px 12px !important;
     padding-bottom: 20px !important;
     margin-bottom: 8px !important;
     box-shadow: 
       inset 2px 0 0 #ff4800,
       inset 0 -2px 0 #ff4800,
       0 15px 25px rgba(255, 0, 0, 0.2) !important;
   }
   
   /* Single-line code blocks (has both begin AND end) */
   .theme-dark .workspace-leaf-content .markdown-source-view.mod-cm6 .HyperMD-codeblock-begin.HyperMD-codeblock-end,
   .theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-codeblock-begin.HyperMD-codeblock-end,
   .theme-dark .markdown-source-view.mod-cm6 .HyperMD-codeblock-begin.HyperMD-codeblock-end {
     border-radius: 12px !important;
     padding: 16px 12px !important;
     margin: 16px 0 !important;
     box-shadow:
       0 0 0 2px #5D5856,
       0 0 0 3px #E0E0E0,
       0 4px 16px rgba(93, 88, 86, 0.2),
       inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;
   }
   
   /* ════════════════════════════════════════════════════════
      SECTION 3: LANGUAGE LABELS
      ═══════════════════════════════════════════════════════ */
   
   /* JavaScript/JS */
