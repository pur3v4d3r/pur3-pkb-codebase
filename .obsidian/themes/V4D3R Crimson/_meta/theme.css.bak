.callout[data-callout="check"],
.callout[data-callout="done"],
.callout[data-callout="complete"],
.callout[data-callout="read-complete"],
.callout[data-callout="win"],
.callout[data-callout="result"],
.callout[data-callout="finding"],
.callout[data-callout="proof"],
.callout[data-callout="outcome"] {
  --callout-color: var(--co-green);
}

/* ─── GROUP 3: Tips & Guidance — Neon Cyan ──────────────────────────────── */
.callout[data-callout="tip"],
.callout[data-callout="hint"],
.callout[data-callout="helpful-tip"],
.callout[data-callout="best-practice"],
.callout[data-callout="how-to"],
.callout[data-callout="how-to-use"],
.callout[data-callout="steps"],
.callout[data-callout="procedure"],
.callout[data-callout="quick-reference"],
.callout[data-callout="recipe"],
.callout[data-callout="try-it"],
.callout[data-callout="practice"],
.callout[data-callout="methodology-and-sources"],
.callout[data-callout="actionable-tips"],
.callout[data-callout="the-start"],
.callout[data-callout="starting-message"] {
  --callout-color: var(--co-cyan);
}

/* ─── GROUP 4: Warning & Caution — Amber ────────────────────────────────── */
.callout[data-callout="warning"],
.callout[data-callout="caution"],
.callout[data-callout="attention"],
.callout[data-callout="important"],
.callout[data-callout="notice"],
.callout[data-callout="alert"],
.callout[data-callout="constraints-and-pitfalls"],
.callout[data-callout="deprecated"],
.callout[data-callout="disclaimer"] {
  --callout-color: var(--co-amber);
}

/* ─── GROUP 5: Danger & Error — Crimson Red ─────────────────────────────── */
.callout[data-callout="danger"],
.callout[data-callout="error"],
.callout[data-callout="bug"],
.callout[data-callout="failure"],
.callout[data-callout="fail"],
.callout[data-callout="missing"],
.callout[data-callout="critical"],
.callout[data-callout="bug-report"],
